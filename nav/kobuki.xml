<!-- Kobuki / TurtleBot 2 base. Dimensions ported from yujinrobot/kobuki_description
     collision primitives (the official meshes are .dae, which MuJoCo cannot load).
     Frame: base_footprint (z=0 on floor, x forward). Robot geoms are group 2 (visible in the viewer by default) so the
     depth camera's rays skip them. -->
<mujoco model="kobuki">
  <default>
    <default class="robot">
      <geom group="2" friction="1 0.005 0.0001"/>
    </default>
  </default>
  <worldbody>
    <body name="robot" childclass="robot">
      <freejoint name="root"/>
      <!-- URDF: cyl r=0.178 l=0.10938 at z=0.05949 above base_link (base_link 0.0102 above floor) -->
      <geom name="base" type="cylinder" size="0.178 0.05469" pos="0 0 0.06969" mass="2.4" rgba=".15 .15 .15 1"/>
      <!-- TurtleBot 2 plates + Astra: lumped mass/collision volume (not in the Kobuki URDF) -->
      <geom name="stack" type="cylinder" size="0.16 0.14" pos="0 0 0.265" mass="1.6" rgba=".75 .75 .75 .35"/>
      <!-- frictionless casters (priority so floor friction/condim does not apply), URDF x positions,
           lifted 1 mm: Kobuki wheels are spring-loaded and carry the weight -->
      <geom name="caster_f" type="sphere" size="0.0175" pos="0.115 0 0.0185" condim="1" priority="1" friction="0 0 0" mass="0.01"/>
      <geom name="caster_b" type="sphere" size="0.0175" pos="-0.135 0 0.0185" condim="1" priority="1" friction="0 0 0" mass="0.01"/>
      <site name="imu" pos="0.056 0.062 0.0304"/>
      <site name="depth_cam" pos="-0.087 0 0.30"/>
      <!-- wheel mass raised from the URDF's 0.01 kg (unphysical) to 0.1 kg; armature = gearmotor
           rotor inertia reflected through the 49.6:1 gearbox (~1e-6 kg m^2 * 49.6^2) -->
      <body name="wheel_l" pos="0 0.115 0.035">
        <joint name="wheel_l" type="hinge" axis="0 1 0" armature="0.0025"/>
        <geom name="wheel_l" type="cylinder" size="0.035 0.0103" zaxis="0 1 0" mass="0.1" condim="3" rgba=".05 .05 .05 1"/>
      </body>
      <body name="wheel_r" pos="0 -0.115 0.035">
        <joint name="wheel_r" type="hinge" axis="0 1 0" armature="0.0025"/>
        <geom name="wheel_r" type="cylinder" size="0.035 0.0103" zaxis="0 1 0" mass="0.1" condim="3" rgba=".05 .05 .05 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- wheel speed servo; forcerange is the motor torque limit (calibration knob) -->
    <velocity name="wheel_l" joint="wheel_l" kv="2" ctrlrange="-20 20" forcerange="-1.5 1.5"/>
    <velocity name="wheel_r" joint="wheel_r" kv="2" ctrlrange="-20 20" forcerange="-1.5 1.5"/>
  </actuator>
  <sensor>
    <jointpos name="enc_l" joint="wheel_l"/>
    <jointpos name="enc_r" joint="wheel_r"/>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="accel" site="imu"/>
  </sensor>
</mujoco>
